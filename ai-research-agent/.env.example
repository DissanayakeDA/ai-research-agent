# Copy this file to .env and fill in your own values.
# Never commit .env - it is listed in .gitignore.

# --- LLM: any OpenAI-compatible Chat Completions API -------------------------
OPENAI_API_KEY=

# Where to send LLM requests. Defaults to OpenAI. Alternatives:
#   Groq (free tier):   https://api.groq.com/openai/v1
#   OpenRouter:         https://openrouter.ai/api/v1
#   Ollama (local):     http://localhost:11434/v1   (use any non-empty OPENAI_API_KEY, e.g. "ollama")
LLM_BASE_URL=https://api.openai.com/v1

# Must be a model that supports tool/function calling on your provider.
LLM_MODEL=gpt-4.1-mini

# --- Web search: Tavily (free developer tier at https://tavily.com) -----------
SEARCH_API_KEY=

# --- Agent behaviour ---------------------------------------------------------
MAX_ITERATIONS=5
MAX_SEARCH_RESULTS=5
DEBUG=false
