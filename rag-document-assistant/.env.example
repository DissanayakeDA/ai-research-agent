# Copy this file to .env and adjust values. Never commit .env - it is listed in .gitignore.
# Empty or missing values fall back to the defaults in app/config.py. Only LLM_API_KEY
# has no default: you must fill it in for a hosted LLM such as Groq.

# --- Storage -------------------------------------------------------------------
# Uploaded PDFs and the ChromaDB index are stored here (relative to this project folder).
DATA_DIR=data
MAX_UPLOAD_MB=20

# --- Chunking (measured in characters; English text averages ~4 characters per token) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings: free, local sentence-transformers model -------------------------
# Downloaded once (~130 MB) from Hugging Face on first use, then runs offline on your machine.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval -----------------------------------------------------------------
TOP_K=4

# --- LLM: any OpenAI-compatible Chat Completions API -----------------------------
# This project uses Groq (https://console.groq.com). It needs an API key, and every question
# sends the question plus the retrieved document passages to Groq. Groq has a rate-limited
# free tier; check your plan's limits and pricing in the Groq console.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
#
# Free local alternative (no key, documents never leave your computer): install
# https://ollama.com, run `ollama pull llama3.2:3b`, then set
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2:3b  LLM_API_KEY= (empty)
LLM_TEMPERATURE=0.0
# Upper limit on tokens the model may generate per answer. Reasoning models such as
# gpt-oss also spend part of this on hidden "thinking" before the visible answer.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# --- Frontend -> backend ---------------------------------------------------------
# Where the Streamlit UI finds the FastAPI server.
API_URL=http://127.0.0.1:8000

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
